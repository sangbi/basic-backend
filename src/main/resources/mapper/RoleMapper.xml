<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.basic.backend.domain.mapper.RoleMapper">

    <select id="findAll" resultType="com.basic.backend.domain.entity.RoleEntity">
        SELECT *
          FROM basic_role
         WHERE status = 'ACTIVE'
         ORDER BY id ASC
    </select>

</mapper>