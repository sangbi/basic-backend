<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.basic.backend.domain.test.repository.mapper.TestMapper">

    <insert id="insert">
        INSERT INTO test (
               message
        ) VALUES (
               #{message}
        )
    </insert>

    <select id="findById" resultType="string" >
        SELECT message
          FROM test
         WHERE id = #{id}
    </select>

</mapper>